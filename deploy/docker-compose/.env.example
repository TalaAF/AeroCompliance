COMPOSE_PROJECT_NAME=aerocompliance
AEROCOMPLIANCE_BIND_ADDRESS=127.0.0.1
AEROCOMPLIANCE_HTTP_PORT=8080
# Choose an unused private subnet if this one overlaps another Docker/VPN network.
# The frontend IP must be inside that subnet and is trusted by the API as its sole remote proxy.
AEROCOMPLIANCE_BACKEND_SUBNET=172.30.250.0/24
AEROCOMPLIANCE_FRONTEND_BACKEND_IP=172.30.250.254
AEROCOMPLIANCE_AI_MODE=mock
AEROCOMPLIANCE_MODEL_DIR=./models
POSTGRES_PASSWORD=change-me-to-a-long-random-value
RABBITMQ_PASSWORD=change-me-to-a-long-random-value
MINIO_SECRET_KEY=change-me-to-a-long-random-value
JWT_SIGNING_KEY=change-me-to-a-random-value-at-least-32-characters
DEMO_PASSWORD=change-me-to-a-demo-password-at-least-12-characters
